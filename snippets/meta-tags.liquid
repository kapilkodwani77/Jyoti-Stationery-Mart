{%- comment -%} Canonical + noindex rules per Vol II §10.4. Include once in <head>. {%- endcomment -%}

{%- comment -%}
  Titles key off the brand setting, not shop.name. The Shopify account is still
  named "Baby Products", and shop.name is what Shopify feeds page_title on the
  homepage — so reading it directly put the account name in every tab and every
  shared link. Same fallback chain the header and footer already use.
{%- endcomment -%}
{%- assign brand = settings.brand_name | default: shop.name -%}

{%- comment -%}
  Captured once and reused for og:title below. The homepage's page_title is
  the account name, which no amount of appending fixes — it has to be
  replaced outright — and og:title read page_title directly, which put
  "Baby Products" into every shared link's preview on the one template
  <title> was written to protect.
{%- endcomment -%}
{%- if template.name == 'index' -%}
  {%- capture doc_title -%}{{ brand }}{% if settings.brand_tagline != blank %} · {{ settings.brand_tagline }}{% endif %}{%- endcapture -%}
{%- else -%}
  {%- capture doc_title -%}{{ page_title }}{% unless page_title contains brand %} · {{ brand }}{% endunless %}{%- endcapture -%}
{%- endif -%}
<title>{{ doc_title }}</title>
{%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}

{%- if template.name == 'page' and page.metafields.custom.lp_canonical_product != blank -%}
  <link rel="canonical" href="{{ shop.url }}{{ page.metafields.custom.lp_canonical_product.value.url }}">
  <meta name="robots" content="noindex,follow">
{%- elsif template.name == 'collection' or template.name == 'search' or template.name == 'cart' -%}
  <link rel="canonical" href="{{ canonical_url }}">
  <meta name="robots" content="noindex,follow">
{%- else -%}
  <link rel="canonical" href="{{ canonical_url }}">
{%- endif -%}

<meta property="og:site_name" content="{{ brand | escape }}">
<meta property="og:title" content="{{ doc_title | escape }}">
{%- if page_description -%}<meta property="og:description" content="{{ page_description | escape }}">{%- endif -%}
<meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if template.name == 'product' and product.featured_image -%}
  <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
{%- endif -%}
