{%- comment -%}
  Renders an inline SVG icon. No requests, no icon font.
  Usage: {% render 'icon', name: 'cart' %}
  Params:
    name (required)
    size (optional, px, default 20)

  The instagram and facebook marks are drawn in the same stroked style as the
  rest of the set rather than dropped in as the official filled logos. A row
  mixing one flat brand glyph with these hairlines reads as a third-party badge
  stuck onto the page; matching the house weight keeps it part of the footer.
{%- endcomment -%}
{%- liquid
  assign s = size | default: 20
-%}
{%- case name -%}
  {%- when 'menu' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'close' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4.5 4.5l11 11M15.5 4.5l-11 11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'cart' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 4h1.6L6 13.2a1.4 1.4 0 0 0 1.4 1.2h6.7a1.4 1.4 0 0 0 1.38-1.16L16.6 7H5.1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="8" cy="17" r="1.1" fill="currentColor"/><circle cx="13.5" cy="17" r="1.1" fill="currentColor"/></svg>
  {%- when 'chevron' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 4.5l6 5.5-6 5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'drag' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 6l-3 4 3 4M13 6l3 4-3 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'phone' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 3.5h2.2l1 3.3-1.6 1.4a9 9 0 0 0 4.2 4.2l1.4-1.6 3.3 1v2.2c0 .9-.8 1.6-1.7 1.5A13.5 13.5 0 0 1 3.5 5.2C3.4 4.3 4.1 3.5 5 3.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
  {%- when 'mail' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="3" y="4.5" width="14" height="11" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M3.5 5.5l6.5 5 6.5-5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'check' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10.5l4 4 8-8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'minus' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4.5 10h11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'search' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="5.25" stroke="currentColor" stroke-width="1.4"/><path d="M12.9 12.9L16.5 16.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'plus' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4.5v11M4.5 10h11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'instagram' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="3.25" y="3.25" width="13.5" height="13.5" rx="4" stroke="currentColor" stroke-width="1.4"/><circle cx="10" cy="10" r="3.35" stroke="currentColor" stroke-width="1.4"/><circle cx="13.9" cy="6.1" r="1" fill="currentColor"/></svg>
  {%- when 'facebook' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="3.25" y="3.25" width="13.5" height="13.5" rx="4" stroke="currentColor" stroke-width="1.4"/><path d="M10.9 16.75V8.9a1.7 1.7 0 0 1 1.7-1.7h.8M8.8 10.9h4.1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endcase -%}
