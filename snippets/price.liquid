{%- comment -%}
  Usage: {% render 'price', variant: product.selected_or_first_available_variant %}
{%- endcomment -%}
<span class="price">
  {{- variant.price | money -}}
  {%- if variant.compare_at_price > variant.price -%}
    <s class="price-compare">{{ variant.compare_at_price | money }}</s>
  {%- endif -%}
</span>
