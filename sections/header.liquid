{%- liquid
  assign menu = section.settings.menu
  assign brand = settings.brand_name | default: shop.name
-%}

<header class="hdr" data-header>
  <button type="button" class="hdr-icon burger" data-nav-open aria-label="Open menu" aria-expanded="false" aria-controls="nav-overlay">
    {% render 'icon', name: 'menu' %}
  </button>

  <a class="mark" href="{{ routes.root_url }}">{{ brand }}</a>

  <nav class="nav-desktop" aria-label="Primary">
    <ul class="nav-list">
      {%- for link in menu.links -%}
        {%- if link.links.size > 0 -%}
          <li class="nav-item nav-has-children">
            <a class="nav-link" href="{{ link.url }}" aria-haspopup="true">
              {{ link.title }}
              <svg class="nav-caret" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="M2 4l3 3 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <ul class="subnav">
              {%- for child in link.links -%}
                <li><a href="{{ child.url }}" {% if child.current %}aria-current="page"{% endif %}>{{ child.title }}</a></li>
              {%- endfor -%}
            </ul>
          </li>
        {%- else -%}
          <li class="nav-item">
            <a class="nav-link" href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </nav>

  {%- comment -%}
    Search shipped fully built (templates/search.json + sections/main-search)
    but had no entry point anywhere in the UI. On desktop it sits beside the
    cart; on mobile it lives at the top of the nav overlay instead, so the
    three-item header stays balanced around the centred wordmark.
  {%- endcomment -%}
  <a class="hdr-icon hdr-search" href="{{ routes.search_url }}" aria-label="Search">
    {% render 'icon', name: 'search' %}
  </a>

  <button type="button" class="hdr-icon cart-icon" data-cart-open
          aria-label="Open cart, {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}">
    {% render 'icon', name: 'cart' %}
    <span class="badge" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
  </button>
</header>

<div class="nav-overlay" id="nav-overlay" data-nav-overlay>
  <div class="nav-overlay-top">
    <span class="mark">{{ brand }}</span>
    <button type="button" class="hdr-icon" data-nav-close aria-label="Close menu" style="color:var(--ink)">
      {% render 'icon', name: 'close' %}
    </button>
  </div>

  <form class="nav-overlay-search" action="{{ routes.search_url }}" method="get" role="search">
    <label class="visually-hidden" for="nav-search">Search products</label>
    <span class="nav-overlay-search-icon" aria-hidden="true">{% render 'icon', name: 'search', size: 18 %}</span>
    <input id="nav-search" type="search" name="q" placeholder="Search products" autocomplete="off">
    <button type="submit" class="visually-hidden">Search</button>
  </form>

  <nav class="nav-overlay-links" aria-label="Primary">
    {%- for link in menu.links -%}
      {%- if link.links.size > 0 -%}
        <details class="nav-m-group">
          <summary>
            <span>{{ link.title }}</span>
            <svg class="nav-m-caret" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M4 3l5 4-5 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <div class="nav-m-children">
            {%- for child in link.links -%}
              <a href="{{ child.url }}" {% if child.current %}aria-current="page"{% endif %}>{{ child.title }}</a>
            {%- endfor -%}
          </div>
        </details>
      {%- else -%}
        <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endif -%}
    {%- endfor -%}
  </nav>

  <div class="nav-overlay-foot">
    {%- if settings.phone != blank -%}<a href="tel:{{ settings.phone | replace: ' ', '' }}">{{ settings.phone }}</a>{%- endif -%}
    {%- if settings.email != blank -%}<a href="mailto:{{ settings.email }}">{{ settings.email }}</a>{%- endif -%}
    <p class="micro" style="margin-top:var(--s-3)">Cash on delivery &middot; 30-day returns</p>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Managed in Shopify admin under Content and then Menus. Supports two levels." }
  ]
}
{% endschema %}