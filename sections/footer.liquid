{{ 'section-footer.css' | asset_url | stylesheet_tag }}
<footer class="ftr">
  <div class="wrap">

    {%- comment -%}
      Email capture. Shopify's native customer form, so it works with JavaScript
      disabled and needs no third-party script — the address lands in Customers
      tagged "newsletter", which is what Shopify Email and Klaviyo both segment
      on. It sits above the link columns because for a pre-launch brand this is
      the footer's most valuable job, not an afterthought beside the legal links.
    {%- endcomment -%}
    {%- if section.settings.signup_show -%}
      <div class="ftr-signup">
        <div>
          <h2 class="ftr-signup-head">{{ section.settings.signup_heading }}</h2>
          {%- if section.settings.signup_body != blank -%}
            <p class="ftr-signup-sub">{{ section.settings.signup_body }}</p>
          {%- endif -%}
        </div>

        {%- form 'customer', id: 'ftr-signup', class: 'ftr-signup-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            {%- comment -%}
              role="status" rather than a bare paragraph: the page has reloaded,
              so a screen reader would otherwise give no sign the signup worked.
            {%- endcomment -%}
            <p class="ftr-signup-note ftr-signup-note--ok" role="status">
              {{ section.settings.signup_thanks }}
            </p>
          {%- else -%}
            <div class="ftr-signup-row">
              <label class="visually-hidden" for="ftr-signup-email">Email address</label>
              <input id="ftr-signup-email"
                     class="ftr-signup-input"
                     type="email"
                     name="contact[email]"
                     value="{{ form.email | escape }}"
                     placeholder="you@example.com"
                     autocomplete="email"
                     required
                     {% if form.errors %}aria-invalid="true" aria-describedby="ftr-signup-err"{% endif %}>
              <button type="submit" class="cta">{{ section.settings.signup_cta }}</button>
            </div>
            {%- if form.errors -%}
              <p class="ftr-signup-note ftr-signup-note--err" id="ftr-signup-err" role="alert">
                {{ form.errors.messages.email | default: 'That address did not look right. Try again?' }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    <div class="ftr-top">
      <div class="ftr-brand">
        <span class="ftr-mark">{{ settings.brand_name | default: shop.name }}</span>
        <p class="ftr-tag">{{ settings.brand_tagline | default: 'Thoughtfully designed for modern families.' }}</p>
      </div>

      <div class="ftr-grid">
        <div>
          <h3>Support</h3>
          <a href="/pages/support">Shipping</a>
          <a href="/pages/support#returns">Returns</a>
          <a href="/pages/support#contact">Contact</a>
        </div>
        <div>
          <h3>Company</h3>
          <a href="/pages/about">About</a>
          <a href="{{ routes.all_products_collection_url }}">Shop all</a>
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>
          {%- endif -%}
        </div>
        <div>
          <h3>Legal</h3>
          <a href="{{ shop.policies.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy</a>
          <a href="{{ shop.policies.terms_of_service.url | default: '/policies/terms-of-service' }}">Terms</a>
          <a href="{{ shop.policies.refund_policy.url | default: '/policies/refund-policy' }}">Refunds</a>
        </div>
      </div>
    </div>

    {%- if settings.phone != blank or settings.email != blank -%}
      <address style="margin-top:32px">
        {%- if settings.phone != blank -%}
          <a href="tel:{{ settings.phone | replace: ' ', '' }}" style="display:inline;padding:0">{{ settings.phone }}</a>
          {%- if settings.phone_hours != blank %} &middot; {{ settings.phone_hours }}{% endif -%}
        {%- endif -%}
      </address>
    {%- endif -%}

    <p class="ftr-base">
      {%- comment -%}
        Falls through to the brand before the account name: no legal entity is
        set yet, and the account is still called "Baby Products".
      {%- endcomment -%}
      <span>&copy; {{ 'now' | date: '%Y' }} {{ settings.legal_entity | default: settings.brand_name | default: shop.name }}</span>
      {%- if settings.gstin != blank -%}<span>GSTIN {{ settings.gstin }}</span>{%- endif -%}
    </p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Email signup" },
    { "type": "checkbox", "id": "signup_show", "label": "Show email signup", "default": true },
    { "type": "text", "id": "signup_heading", "label": "Heading", "default": "Be first to know." },
    { "type": "textarea", "id": "signup_body", "label": "Supporting line", "default": "We are still setting up. Leave your email and we will tell you the day the mat is ready. Nothing else." },
    { "type": "text", "id": "signup_cta", "label": "Button label", "default": "Notify me" },
    { "type": "text", "id": "signup_thanks", "label": "Thank-you message", "default": "You are on the list. We will be in touch." }
  ]
}
{% endschema %}