{%- liquid
  assign dest = section.settings.cta_collection.url | default: routes.all_products_collection_url
-%}
<section class="sec {% render 'surface-class', s: section.settings.surface %}">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.body != blank -%}
      <p class="lede body-copy">{{ section.settings.body }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <div style="margin-top:var(--s-7)">
        <a class="cta" href="{{ dest }}">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brand statement",
  "settings": [
    { "type": "select", "id": "surface", "label": "Surface", "default": "chalk", "options": [{ "value": "chalk", "label": "Chalk" }, { "value": "jute", "label": "Jute wash" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thoughtful essentials for the early years." },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "collection", "id": "cta_collection", "label": "Button destination" },
    { "type": "text", "id": "cta_label", "label": "Button label" }
  ],
  "presets": [{ "name": "Brand statement" }]
}
{% endschema %}