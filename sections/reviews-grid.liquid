{%- comment -%}
  Requires a metaobject definition named "review" (Settings -> Custom data ->
  Metaobjects) with fields: rating (Integer 1-5), quote, customer_name,
  customer_city, photo.
  Auto-hides entirely when zero reviews exist. Appears automatically once
  the first review metaobject entry is published. No fake content, ever.
{%- endcomment -%}
{%- liquid
  assign reviews = metaobjects.review.values
  assign count = reviews.size
-%}
{%- if count > 0 -%}
  {%- liquid
    assign sum = 0
    for r in reviews
      assign sum = sum | plus: r.rating.value
    endfor
    assign avg = sum | times: 1.0 | divided_by: count
  -%}
{{ 'section-reviews.css' | asset_url | stylesheet_tag }}
  <section class="sec {% render 'surface-class', s: section.settings.surface %}">
    <div class="wrap">
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <p class="rev-agg"><strong>{{ avg | round: 1 }}</strong> from {{ count }} order{% if count != 1 %}s{% endif %}</p>

      <div class="rev-grid">
        {%- for r in reviews limit: section.settings.max_reviews -%}
          <article class="rev-card" data-reveal>
            <div class="rev-photo">
              {%- if r.photo.value -%}
                {% render 'responsive-image', img: r.photo.value, alt: 'Customer photo shared by ' | append: r.customer_name.value, widths: '400,600', sizes: '(min-width:1100px) 33vw, (min-width:700px) 50vw, 100vw' %}
              {%- else -%}
                <div class="img-missing"><span>Photo pending</span></div>
              {%- endif -%}
            </div>
            <div class="rev-stars" aria-label="Rated {{ r.rating.value }} out of 5">{% for i in (1..5) %}{% if i <= r.rating.value %}\u2605{% else %}\u2606{% endif %}{% endfor %}</div>
            <p class="rev-quote">{{ r.quote.value }}</p>
            <p class="rev-byline">{{ r.customer_name.value }}{% if r.customer_city.value %}, {{ r.customer_city.value }}{% endif %}</p>
          </article>
        {%- endfor -%}
      </div>

      <p class="rev-foot">Every review here is from a verified order. We do not edit them and we do not remove the bad ones.</p>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "select", "id": "surface", "label": "Surface", "default": "chalk", "options": [{ "value": "chalk", "label": "Chalk" }, { "value": "jute", "label": "Jute wash" }] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What parents are saying." },
    { "type": "range", "id": "max_reviews", "label": "Reviews shown", "min": 3, "max": 12, "step": 3, "default": 6 }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}