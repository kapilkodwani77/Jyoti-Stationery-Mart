{%- comment -%}
  Scalable product grid, not a single-product spotlight. Works identically
  with 1 product or 100. Product titles are rendered exactly as stored -
  never truncated, rewritten, or modified (clamped visually to 2 lines only).
  Collection priority: section.settings.collection -> settings.featured_collection -> collections.all

  The card itself lives in snippets/product-card.liquid and is shared with the
  collection page, so both grids stay identical by construction rather than by
  remembering to edit two files.
{%- endcomment -%}
{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = settings.featured_collection
  endif
  if col == blank
    assign col = collections.all
  endif
-%}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{%- if col != blank and col.products.size > 0 -%}
<section class="sec {% if section.settings.compact %}sec--tight{% endif %} {% render 'surface-class', s: section.settings.surface %}">
  <div class="wrap">
    <div class="pc-head">
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if col.products_count > section.settings.max_products -%}
        <a class="pc-viewall" href="{{ col.url }}">
          View all<span class="visually-hidden"> {{ section.settings.heading }}</span> ({{ col.products_count }})
        </a>
      {%- endif -%}
    </div>

    <div class="pc-grid">
      {%- for p in col.products limit: section.settings.max_products -%}
        {% render 'product-card',
           product: p,
           sizes: '(min-width:1100px) 25vw, (min-width:700px) 30vw, 45vw',
           reveal: true %}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Our products",
  "settings": [
    { "type": "checkbox", "id": "compact", "label": "Reduce vertical padding", "default": true },
    { "type": "select", "id": "surface", "label": "Surface", "default": "chalk", "info": "Mist is the cool surface. It is meant to mark the shopping part of a long page, so use it once per page or it stops standing out.", "options": [{ "value": "chalk", "label": "Chalk" }, { "value": "jute", "label": "Jute wash" }, { "value": "mist", "label": "Mist (cool)" }] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our products" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Falls back to the theme Featured collection, then all products. Grid scales automatically as products are added." },
    { "type": "range", "id": "max_products", "label": "Products shown", "min": 4, "max": 12, "step": 4, "default": 8 }
  ],
  "presets": [{ "name": "Our products" }]
}
{% endschema %}