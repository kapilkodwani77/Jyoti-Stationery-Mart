{%- comment -%}
  TEMPORARY runtime instrumentation for the sticky buy bar. Delete this file
  and its {% section %} line in layout/theme.liquid once the cause is found.

  Renders a fixed readout at the TOP of the viewport (the Shopify preview bar
  owns the bottom, so a bottom-anchored panel would be occluded by the very
  thing we are trying to measure).

  Add ?forcebar=1 to the URL to pin .on regardless of scroll position, which
  separates "the class is never added" from "the class is added and something
  is painting over it".
{%- endcomment -%}
<div id="bbdbg" role="region" aria-label="Sticky buy bar diagnostics"></div>
<style>
  #bbdbg{
    position:fixed; top:0; left:0; right:0; z-index:2147483000;
    background:#0b0d10; color:#7CFFB2; font:11px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace;
    padding:6px 8px; white-space:pre-wrap; word-break:break-word;
    border-bottom:2px solid #7CFFB2; max-height:46vh; overflow:auto;
  }
  #bbdbg b{ color:#fff; }
  #bbdbg .bad{ color:#FF6B6B; }
  #bbdbg .ok{ color:#7CFFB2; }
</style>
<script>
(function () {
  var errs = [];
  window.addEventListener('error', function (e) { errs.push(e.message); });

  function start() {
    var out = document.getElementById('bbdbg');
    if (!out) return;

    var force = /[?&]forcebar=1/.test(location.search);

    function describe(el) {
      if (!el) return 'null';
      var s = el.tagName.toLowerCase();
      if (el.id) s += '#' + el.id;
      if (el.className && typeof el.className === 'string' && el.className.trim()) {
        s += '.' + el.className.trim().split(/\s+/).slice(0, 3).join('.');
      }
      return s;
    }

    function render() {
      var bar = document.querySelector('[data-buybar]');
      var anchorExplicit = document.querySelector('[data-buybar-anchor]');
      var anchorFallback = document.querySelector('[data-buybox]');
      var anchor = anchorExplicit || anchorFallback;
      var hideEl = document.querySelector('[data-buybar-hide]');
      var vh = window.innerHeight;
      var L = [];

      L.push('<b>1 bar in DOM:</b> ' + (bar ? '<span class=ok>YES</span>' : '<span class=bad>NO</span>')
             + ' (count=' + document.querySelectorAll('[data-buybar]').length + ')');

      if (!bar) { out.innerHTML = L.join('\n'); return; }

      if (force && !bar.classList.contains('on')) bar.classList.add('on');

      L.push('<b>2 anchor:</b> explicit=' + (anchorExplicit ? 'YES' : 'NO')
             + ' fallback=' + (anchorFallback ? 'YES' : 'NO')
             + ' used=' + describe(anchor));
      L.push('   barContainsAnchor=' + (anchor ? bar.contains(anchor) : 'n/a')
             + '  (true here would abort buybar())');

      if (anchor) {
        var ar = anchor.getBoundingClientRect();
        var onScreen = ar.bottom > 0 && ar.top < vh;
        L.push('<b>3 anchor rect:</b> top=' + Math.round(ar.top) + ' bottom=' + Math.round(ar.bottom)
               + ' h=' + Math.round(ar.height) + ' vh=' + vh);
        L.push('   intersecting=' + (onScreen ? '<span class=bad>YES (bar must stay hidden)</span>'
                                              : '<span class=ok>NO (bar should show)</span>'));
      }

      if (hideEl) {
        var hr = hideEl.getBoundingClientRect();
        var vis = Math.max(0, Math.min(hr.bottom, vh) - Math.max(hr.top, 0));
        L.push('<b>4 hideEl(footer):</b> top=' + Math.round(hr.top) + ' h=' + Math.round(hr.height)
               + ' visible=' + Math.round(vis) + ' ratio=' + (hr.height ? (vis / hr.height).toFixed(3) : '0'));
      } else {
        L.push('<b>4 hideEl(footer):</b> <span class=bad>NOT FOUND</span>');
      }

      var hasOn = bar.classList.contains('on');
      L.push('<b>5 .on class:</b> ' + (hasOn ? '<span class=ok>PRESENT</span>' : '<span class=bad>ABSENT</span>')
             + (force ? ' (FORCED)' : ''));

      var cs = getComputedStyle(bar);
      L.push('<b>6 computed:</b> display=' + cs.display + ' vis=' + cs.visibility
             + ' opacity=' + cs.opacity + ' z=' + cs.zIndex + ' pe=' + cs.pointerEvents);
      L.push('   position=' + cs.position + ' bottom=' + cs.bottom);
      L.push('   transform=' + cs.transform);

      var br = bar.getBoundingClientRect();
      L.push('<b>7 bar rect:</b> top=' + Math.round(br.top) + ' bottom=' + Math.round(br.bottom)
             + ' h=' + Math.round(br.height) + ' w=' + Math.round(br.width));
      L.push('   gapBelow=' + Math.round(vh - br.bottom) + '  (0 = flush to viewport bottom)');

      // THE OVERLAY TEST: what is actually painted where the bar lives?
      var cx = Math.round(br.left + br.width / 2);
      var probes = [
        ['bar centre', cx, Math.round(br.top + br.height / 2)],
        ['bar top+6', cx, Math.round(br.top + 6)],
        ['vh-8', cx, vh - 8]
      ];
      L.push('<b>8 elementFromPoint (occlusion test):</b>');
      probes.forEach(function (p) {
        var el = document.elementFromPoint(p[1], p[2]);
        var isBar = !!(el && (el === bar || bar.contains(el)));
        L.push('   ' + p[0] + ' (' + p[1] + ',' + p[2] + ') -> ' + describe(el)
               + (isBar ? ' <span class=ok>[BAR]</span>' : ' <span class=bad>[NOT BAR]</span>'));
      });

      L.push('<b>9 js errors:</b> ' + (errs.length ? '<span class=bad>' + errs.length + ': ' + errs[0] + '</span>' : '<span class=ok>none</span>'));
      L.push('<b>10 scrollY:</b> ' + Math.round(window.scrollY) + '  docH=' + document.documentElement.scrollHeight);

      out.innerHTML = L.join('\n');
    }

    var tick = false;
    function sched() {
      if (tick) return;
      tick = true;
      requestAnimationFrame(function () { tick = false; render(); });
    }
    window.addEventListener('scroll', sched, { passive: true });
    window.addEventListener('resize', sched);
    setInterval(render, 500);
    render();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})();
</script>

{% schema %}
{ "name": "Buybar debug (temporary)" }
{% endschema %}
