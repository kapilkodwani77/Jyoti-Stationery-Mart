{{ 'section-faq.css' | asset_url | stylesheet_tag }}
<section class="sec {% if section.settings.compact %}sec--tight{% endif %} {% render 'surface-class', s: section.settings.surface %}"
         id="jump-{{ section.id }}"
         {% if section.settings.jump_label != blank %}data-jump="{{ section.settings.jump_label | escape }}"{% endif %}>
  <div class="wrap">
    <h2 class="h2">{{ section.settings.heading }}</h2>

    <div class="faq">
      {%- for block in section.blocks -%}
        <details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question }}</span>
            <span class="chev" aria-hidden="true">{% render 'icon', name: 'chevron', size: 14 %}</span>
          </summary>
          <div class="ans">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if template.name == 'index' or template.name == 'product' -%}
  {%- capture faq_ld -%}
    {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
    {%- for block in section.blocks -%}
      {"@type":"Question","name":{{ block.settings.question | strip_html | json }},
      "acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}]}
  {%- endcapture -%}
  <script type="application/ld+json">{{ faq_ld }}</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "jump_label", "label": "Jump-nav label", "default": "FAQ", "info": "Short label for the in-page nav at the top of the product page. Clear it to leave this section out of the nav." },
    { "type": "checkbox", "id": "compact", "label": "Reduce vertical padding", "default": false },
    { "type": "select", "id": "surface", "label": "Surface", "default": "jute", "options": [{ "value": "chalk", "label": "Chalk" }, { "value": "jute", "label": "Jute wash" }] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions we actually get." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}