{{ 'section-collection-grid.css' | asset_url | stylesheet_tag }}
<section class="sec {% render 'surface-class', s: section.settings.surface %}">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="cg-head">
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}<p class="lede body-copy">{{ section.settings.body }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="cg-grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign card_title = block.settings.title | default: col.title
          assign count = col.products_count | default: 0
          assign img = block.settings.image | default: col.image
          if img == blank and col.products.first
            assign img = col.products.first.featured_image
          endif
        -%}
        {%- if col != blank -%}
          <a class="cg-card{% if count == 0 %} is-empty{% endif %}" role="listitem" href="{{ col.url }}" {{ block.shopify_attributes }} data-reveal>
            <div class="cg-media">
              {% render 'responsive-image', img: img, alt: card_title, widths: '400,600,900', sizes: '(min-width:900px) 30vw, 45vw' %}
              {%- if count == 0 -%}
                <span class="cg-badge">Coming soon</span>
              {%- endif -%}
            </div>
            <div class="cg-meta">
              <p class="cg-title">{{ card_title }}</p>
              <p class="cg-count">
                {%- if count == 0 -%}
                  In development
                {%- elsif count == 1 -%}
                  1 product
                {%- else -%}
                  {{ count }} products
                {%- endif -%}
              </p>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank and section.settings.cta_collection != blank -%}
      <div class="cg-foot">
        <a class="cta-outline" href="{{ section.settings.cta_collection.url }}">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "select", "id": "surface", "label": "Surface", "default": "chalk", "options": [{ "value": "chalk", "label": "Chalk" }, { "value": "jute", "label": "Jute wash" }] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "textarea", "id": "body", "label": "Intro text" },
    { "type": "header", "content": "Footer link" },
    { "type": "collection", "id": "cta_collection", "label": "Button destination" },
    { "type": "text", "id": "cta_label", "label": "Button label" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Override title", "info": "Leave blank to use the collection name." },
        { "type": "image_picker", "id": "image", "label": "Override image", "info": "Falls back to the collection image, then the first product image." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Collection grid" }]
}
{% endschema %}