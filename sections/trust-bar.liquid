{{ 'section-trust-bar.css' | asset_url | stylesheet_tag }}
<section class="sec sec--tight {% render 'surface-class', s: section.settings.surface %}">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="tb-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="trust-bar" role="list">
      {%- for block in section.blocks -%}
        <div class="trust-item" role="listitem" {{ block.shopify_attributes }}>
          <div class="trust-icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 3L4 6.5v5.2c0 4.8 3.4 9.2 8 10.3 4.6-1.1 8-5.5 8-10.3V6.5L12 3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 12l2 2 4-4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'droplet' -%}
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 3S6 9.5 6 13.5a6 6 0 0 0 12 0C18 9.5 12 3 12 3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24" fill="none"><path d="M6 19c0 0 6-1.5 9-7.5 1.5-3 1.5-7.5 1.5-7.5S10.5 4.5 7.5 7.5C4.5 10.5 4.5 16 6 19z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M6 19l7.5-9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity=".5"/></svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none"><path d="M3 7.5h10v9H3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M13 11h4l3 3v2.5h-7z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><circle cx="7" cy="18" r="1.6" stroke="currentColor" stroke-width="1.4"/><circle cx="17" cy="18" r="1.6" stroke="currentColor" stroke-width="1.4"/></svg>
              {%- when 'wallet' -%}
                <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.4"/><circle cx="16.5" cy="14.5" r="1.3" stroke="currentColor" stroke-width="1.3"/></svg>
              {%- when 'return' -%}
                <svg viewBox="0 0 24 24" fill="none"><path d="M20 12a8 8 0 1 1-2.6-5.9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M20 4v4.5h-4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'heart' -%}
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 20.5s-7.5-4.6-7.5-10a4.6 4.6 0 0 1 7.5-3.5A4.6 4.6 0 0 1 19.5 10.5c0 5.4-7.5 10-7.5 10z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
              {%- when 'sparkle' -%}
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 3.5v3M12 17.5v3M3.5 12h3M17.5 12h3M6 6l2 2M16 16l2 2M18 6l-2 2M8 16l-2 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.4"/></svg>
              {%- when 'home' -%}
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 10.5L12 4l8 6.5V20a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9.5 21v-6h5v6" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
            {%- endcase -%}
          </div>
          <p class="trust-label">{{ block.settings.label }}</p>
          {%- if block.settings.description != blank -%}
            <p class="trust-desc">{{ block.settings.description }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "settings": [
    { "type": "select", "id": "surface", "label": "Surface", "default": "jute", "options": [{ "value": "chalk", "label": "Chalk" }, { "value": "jute", "label": "Jute wash" }] },
    { "type": "text", "id": "heading", "label": "Heading (optional)" }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Trust point",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "shield",
          "options": [
            { "value": "shield", "label": "Shield (safety)" },
            { "value": "leaf", "label": "Leaf (materials)" },
            { "value": "droplet", "label": "Droplet (easy clean)" },
            { "value": "truck", "label": "Truck (shipping)" },
            { "value": "wallet", "label": "Wallet (payment)" },
            { "value": "return", "label": "Return (returns)" },
            { "value": "heart", "label": "Heart (care)" },
            { "value": "sparkle", "label": "Sparkle (quality)" },
            { "value": "home", "label": "Home (design)" }
          ]
        },
        { "type": "text", "id": "label", "label": "Title", "default": "Trust point" },
        { "type": "text", "id": "description", "label": "One supporting sentence" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Trust bar" }]
}
{% endschema %}