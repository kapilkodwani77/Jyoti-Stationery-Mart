{%- comment -%}
  Pure brand imagery. Two layouts:
    stacked      - image above, centered text below, generous whitespace
    side-by-side - compact editorial block, image and text in a row on every viewport
  Leave heading and body blank for an image-only atmospheric block.
{%- endcomment -%}
{{ 'section-brand-imagery.css' | asset_url | stylesheet_tag }}
<section class="sec {% if section.settings.layout == 'side' %}sec--tight bi-editorial{% elsif section.settings.compact %}sec--tight{% endif %} {% render 'surface-class', s: section.settings.surface %}">
  <div class="wrap">
    {%- if section.settings.layout == 'side' -%}
      <div class="bi-side" data-reveal>
        <div class="bi-side-media">
          {% render 'responsive-image', img: section.settings.image, alt: section.settings.image_alt, widths: '400,600,900', sizes: '(min-width:700px) 35vw, 40vw' %}
        </div>
        {%- if section.settings.heading != blank or section.settings.body != blank -%}
          <div class="bi-side-copy">
            {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
            {%- if section.settings.heading != blank -%}<h2 class="h3">{{ section.settings.heading }}</h2>{%- endif -%}
            {%- if section.settings.body != blank -%}<p class="body-copy bi-side-body">{{ section.settings.body }}</p>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="bi-media" data-reveal>
        {% render 'responsive-image', img: section.settings.image, alt: section.settings.image_alt, widths: '700,1100,1600', sizes: '(min-width:900px) 900px, 100vw' %}
      </div>
      {%- if section.settings.heading != blank or section.settings.body != blank -%}
        <div class="bi-copy" data-reveal>
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" style="text-align:center">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.body != blank -%}<p class="lede body-copy">{{ section.settings.body }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brand imagery",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "stacked", "options": [{ "value": "stacked", "label": "Stacked (image above text)" }, { "value": "side", "label": "Side by side (compact editorial)" }] },
    { "type": "checkbox", "id": "compact", "label": "Reduce vertical padding (stacked layout only)", "default": false },
    { "type": "select", "id": "surface", "label": "Surface", "default": "chalk", "options": [{ "value": "chalk", "label": "Chalk" }, { "value": "jute", "label": "Jute wash" }] },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "header", "content": "Optional copy - leave blank for image only" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "body", "label": "Body" }
  ],
  "presets": [{ "name": "Brand imagery" }]
}
{% endschema %}