{{ 'section-pdp-benefits.css' | asset_url | stylesheet_tag }}
<section class="sec sec--tight pdp-benefits {% render 'surface-class', s: section.settings.surface %}">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="pdp-ben-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="pdp-ben-grid">
      {%- for block in section.blocks -%}
        <div class="pdp-ben-item" {{ block.shopify_attributes }}>
          <div class="pdp-ben-icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'cushion' -%}<svg width="24" height="24" viewBox="0 0 28 28" fill="none"><ellipse cx="14" cy="18" rx="10" ry="7" stroke="currentColor" stroke-width="1.5"/><path d="M5 18c0-4.5 4-9 9-9s9 4.5 9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              {%- when 'droplet' -%}<svg width="24" height="24" viewBox="0 0 28 28" fill="none"><path d="M14 3S7 11.5 7 16a7 7 0 0 0 14 0c0-4.5-7-13-7-13z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M11 17.5a3 3 0 0 0 3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
              {%- when 'shield' -%}<svg width="24" height="24" viewBox="0 0 28 28" fill="none"><path d="M14 3L4 7.5v6.3c0 5.8 4.3 11.2 10 12.7 5.7-1.5 10-6.9 10-12.7V7.5L14 3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M10 14l3 3 5-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'sparkle' -%}<svg width="24" height="24" viewBox="0 0 28 28" fill="none"><path d="M14 3v4M14 21v4M3 14h4M21 14h4M6.5 6.5l2.8 2.8M18.7 18.7l2.8 2.8M21.5 6.5l-2.8 2.8M9.3 18.7l-2.8 2.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="14" cy="14" r="4" stroke="currentColor" stroke-width="1.5"/></svg>
              {%- when 'fold' -%}<svg width="24" height="24" viewBox="0 0 28 28" fill="none"><rect x="4" y="6" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M14 6v16M9 6v16" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2 2.5" opacity=".5"/><path d="M18 11l3-2.5M18 11l3 2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'expand' -%}<svg width="24" height="24" viewBox="0 0 28 28" fill="none"><path d="M4 11V4h7M24 11V4h-7M4 17v7h7M24 17v7h-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><rect x="9" y="9" width="10" height="10" rx="1.5" stroke="currentColor" stroke-width="1.3"/></svg>
              {%- when 'heart' -%}<svg width="24" height="24" viewBox="0 0 28 28" fill="none"><path d="M14 24s-9-5.5-9-12a5.5 5.5 0 0 1 9-4.2A5.5 5.5 0 0 1 23 12c0 6.5-9 12-9 12z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
            {%- endcase -%}
          </div>
          <div>
            <p class="pdp-ben-title">{{ block.settings.title }}</p>
            {%- if block.settings.text != blank -%}
              <p class="pdp-ben-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product benefits",
  "settings": [
    { "type": "select", "id": "surface", "label": "Surface", "default": "chalk", "options": [{ "value": "chalk", "label": "Chalk" }, { "value": "jute", "label": "Jute wash" }] },
    { "type": "text", "id": "heading", "label": "Heading (optional)" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [{ "value": "cushion", "label": "Cushion" }, { "value": "droplet", "label": "Droplet" }, { "value": "shield", "label": "Shield" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "fold", "label": "Fold" }, { "value": "expand", "label": "Expand" }, { "value": "heart", "label": "Heart" }] },
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit title" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Product benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "expand", "title": "Extra Large 6.5 \u00d5 5 ft", "text": "Spacious safe zone for crawling, tummy time and first steps." } },
        { "type": "benefit", "settings": { "icon": "cushion", "title": "6 mm thick XPE foam", "text": "Soft landing for everyday falls on hard tiles and marble." } },
        { "type": "benefit", "settings": { "icon": "shield", "title": "Baby-safe, non-toxic", "text": "BPA free, phthalate free, no harmful chemicals, odour free." } },
        { "type": "benefit", "settings": { "icon": "droplet", "title": "Waterproof, wipes clean", "text": "No machine washing. A damp cloth handles milk spills and messes." } },
        { "type": "benefit", "settings": { "icon": "fold", "title": "Folds in three panels", "text": "Stands behind a sofa or door. Frees your floor when playtime ends." } },
        { "type": "benefit", "settings": { "icon": "heart", "title": "0 to 3 years", "text": "From newborn tummy time to confident walking." } }
      ]
    }
  ]
}
{% endschema %}